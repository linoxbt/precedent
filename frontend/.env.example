# Deployed Precedent Engine contract address on GenLayer Asimov Testnet. Required.
NEXT_PUBLIC_PRECEDENT_ENGINE_ADDRESS=

# Optional override for the GenLayer RPC endpoint (defaults to the Asimov testnet RPC).
NEXT_PUBLIC_GENLAYER_RPC_URL=

# Reown (WalletConnect) Project ID — create one free at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
