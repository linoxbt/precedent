# Deployed Precedent Engine contract addresses, one per GenLayer network.
# Asimov and Bradbury are the same underlying chain (id 4221) reached via
# different RPC gateways, so they're typically the same address.
NEXT_PUBLIC_PRECEDENT_ENGINE_ADDRESS_ASIMOV=
NEXT_PUBLIC_PRECEDENT_ENGINE_ADDRESS_BRADBURY=
NEXT_PUBLIC_PRECEDENT_ENGINE_ADDRESS_STUDIO=

# Optional RPC endpoint overrides, one per network (each defaults to
# GenLayer's own public RPC for that network).
NEXT_PUBLIC_GENLAYER_RPC_URL_ASIMOV=
NEXT_PUBLIC_GENLAYER_RPC_URL_BRADBURY=
NEXT_PUBLIC_GENLAYER_RPC_URL_STUDIO=

# Reown (WalletConnect) Project ID: create one free at https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=
